FROM condaforge/miniforge3:latest

# Pin base env to Python 3.11 (matches project spec; needed for pip deps)
RUN mamba install -y python=3.11 && mamba clean --all -y

WORKDIR /build

# OS dependencies needed by bioinformatics tools and psycopg2
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc g++ make \
    libpq-dev \
    git \
    curl \
    procps \
    && rm -rf /var/lib/apt/lists/*

# Install all radar-* conda environments (envs only, no databases)
COPY install.sh /build/install.sh
RUN chmod +x /build/install.sh && /build/install.sh -e && \
    mamba clean --all -y && \
    # Strip conda envs: docs, tests, man pages, static libs, __pycache__, include headers
    find /opt/conda/envs -type d -name "__pycache__" -exec rm -rf {} + 2>/dev/null; \
    find /opt/conda/envs -type d -name "tests" -not -path "*/numpy/*" -exec rm -rf {} + 2>/dev/null; \
    find /opt/conda/envs -type d -name "test" -not -path "*/numpy/*" -exec rm -rf {} + 2>/dev/null; \
    find /opt/conda/envs -type d -name "man" -exec rm -rf {} + 2>/dev/null; \
    find /opt/conda/envs -type d -name "doc" -exec rm -rf {} + 2>/dev/null; \
    find /opt/conda/envs -type d -name "docs" -exec rm -rf {} + 2>/dev/null; \
    find /opt/conda/envs -type f -name "*.a" -delete 2>/dev/null; \
    find /opt/conda/envs -type f -name "*.pyc" -delete 2>/dev/null; \
    find /opt/conda/envs -type f -name "*.pyo" -delete 2>/dev/null; \
    find /opt/conda/envs -type f -name "*.la" -delete 2>/dev/null; \
    find /opt/conda/envs -type d -name "include" -exec rm -rf {} + 2>/dev/null; \
    find /opt/conda/envs -type d -name "share/doc" -exec rm -rf {} + 2>/dev/null; \
    find /opt/conda/envs -type d -name "share/man" -exec rm -rf {} + 2>/dev/null; \
    find /opt/conda/envs -type d -name "share/info" -exec rm -rf {} + 2>/dev/null; \
    find /opt/conda/envs -type d -name "share/gtk-doc" -exec rm -rf {} + 2>/dev/null; \
    # Strip locale archives (~440MB)
    find /opt/conda/envs -name "locale-archive*" -delete 2>/dev/null; \
    # Strip any leftover NVIDIA/CUDA libs (CPU-only install, should be minimal)
    find /opt/conda/envs -path "*/nvidia/nccl*" -exec rm -rf {} + 2>/dev/null; \
    find /opt/conda/envs -path "*/nvidia/cudnn*" -exec rm -rf {} + 2>/dev/null; \
    find /opt/conda/envs -path "*/nvidia/cusparselt*" -exec rm -rf {} + 2>/dev/null; \
    find /opt/conda/envs -path "*/site-packages/triton" -exec rm -rf {} + 2>/dev/null; \
    # Strip base env too
    find /opt/conda -maxdepth 5 -type d -name "__pycache__" -exec rm -rf {} + 2>/dev/null; \
    rm -rf /opt/conda/pkgs /build

# Install Python dependencies for the worker
WORKDIR /app
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy backend source
COPY backend/ .

# Databases are mounted at runtime at /databases
# (matches resolved path from backend/app/core/*.py: 4 dirs up from app/core/X.py → /)
VOLUME ["/databases"]

CMD ["celery", "-A", "app.celery_app", "worker", "--loglevel=info", "-Q", "pipeline,celery"]
