# Optional RADAR settings. Copy to .env and edit; start.sh loads it.
# Ports are set in data/ports.env (created from your UID on the first ./start.sh).

# Secret for login tokens. Leave unset to have start.sh generate one in data/jwt_secret.
# RADAR_JWT_SECRET_KEY=

# Public URL of the frontend (used in account-verification e-mails)
# RADAR_BASE_URL=http://localhost:8200

# Outgoing mail for account verification (optional; if empty, new accounts are not e-mail verified)
# RADAR_SMTP_HOST=
# RADAR_SMTP_PORT=587
# RADAR_SMTP_USER=
# RADAR_SMTP_PASSWORD=
# RADAR_SMTP_FROM=
